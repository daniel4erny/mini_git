{
	# http -> https přesměrování řešíme sami níž, :80 musí dál obsluhovat LAN
	auto_https disable_redirects
}

(app) {
	# git klient (clone/pull/push/create)
	handle /repos/* {
		reverse_proxy fastapi_api:3000
	}

	# API pro frontend, /api se odstraní: /api/web/x -> /web/x
	handle_path /api/* {
		reverse_proxy fastapi_api:3000
	}

	# React build, neznámé cesty spadnou na index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# venku přes https, certifikát z Let's Encrypt
# ověření jde přes http na veřejném portu 80 (router: 80 -> djt-server:8091)
homelab.djt-group.com:8443 {
	import app
}

# doména přes http -> https, Let's Encrypt challenge vyřídí Caddy sám ještě před tímhle
http://homelab.djt-group.com {
	redir https://homelab.djt-group.com:8443{uri} permanent
}

# LAN přes http (djt-server:8091)
:80 {
	import app
}
